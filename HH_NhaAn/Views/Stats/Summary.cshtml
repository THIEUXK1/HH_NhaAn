@model SummaryVm
@{
    ViewData["Title"] = "Tổng hợp";
    string N(int x) => x == 0 ? "" : x.ToString("N0");
    string M(decimal x) => x.ToString("N0");
    var modeLabel = Model.Mode switch { "vn" => "cơm Việt Nam", "cn" => "cơm Trung Quốc", _ => "tất cả" };
    var grand = Model.ColTotals.Sum();
}

<form method="get" class="row g-2 align-items-end mb-3 no-print">
    <partial name="_PeriodFilter" model="Model" />
    <div class="col-auto">
        <label class="form-label small mb-0">Loại cơm</label>
        <select name="mode" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="all" selected="@(Model.Mode == "all")">Tất cả</option>
            <option value="vn" selected="@(Model.Mode == "vn")">Cơm Việt Nam</option>
            <option value="cn" selected="@(Model.Mode == "cn")">Cơm Trung Quốc</option>
        </select>
    </div>
    <div class="col-auto">
        <div class="form-check mb-1">
            <input class="form-check-input" type="checkbox" name="detail" value="true" id="detail" checked="@Model.Detail" onchange="this.form.submit()" />
            <label class="form-check-label small" for="detail">Tách từng bộ phận (không gộp nhóm)</label>
        </div>
    </div>
    <div class="col-auto"><button class="btn btn-primary btn-sm">Xem</button></div>
    <div class="col-auto ms-auto">
        <button type="button" class="btn btn-outline-success btn-sm" onclick="exportExcel('sumTable','TongHop_@(Model.From.ToString("yyyyMMdd"))-@(Model.To.ToString("yyyyMMdd"))')">Xuất Excel</button>
        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.print()">In</button>
    </div>
</form>

<div class="table-responsive">
<table class="table table-bordered table-sm stat-table text-center align-middle" id="sumTable">
    <thead>
        <tr><th colspan="@(Model.Columns.Count + 2)" class="title-row">
            BẢNG TỔNG HỢP BÁO CƠM CÁC BỘ PHẬN<br />
            <span class="fw-normal small">Từ @Model.From.ToString("dd/MM/yyyy") đến @Model.To.ToString("dd/MM/yyyy") · Số liệu @Model.SrcLabel · Loại: @modeLabel</span>
        </th></tr>
        <tr>
            <th>Ngày</th>
            @foreach (var c in Model.Columns) { <th>@c</th> }
            <th class="tot">TỔNG</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model.Rows)
        {
            <tr class="@(r.HasData ? "" : "nodata") @(r.Date.DayOfWeek == DayOfWeek.Sunday ? "sunday" : "")">
                <td class="text-nowrap"><a href="@Url.Action("Index", "Report", new { date = r.Date.ToString("yyyy-MM-dd") })">@r.Date.ToString("dd-MM")</a></td>
                @foreach (var v in r.Values) { <td>@N(v)</td> }
                <td class="tot">@N(r.Values.Sum())</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr class="grandtotal">
            <td>Tổng suất</td>
            @foreach (var t in Model.ColTotals) { <td>@N(t)</td> }
            <td>@N(grand)</td>
        </tr>
        <tr>
            <td>Thành tiền</td>
            @foreach (var m in Model.ColMoney) { <td>@M(m)</td> }
            <td class="fw-bold">@M(Model.ColMoney.Sum())</td>
        </tr>
        <tr>
            <td colspan="@(Model.Columns.Count + 2)" class="text-start small text-muted">
                Đơn giá: cơm VN @M(Model.Settings.PriceVn)đ/suất · cơm TQ @M(Model.Settings.PriceCn)đ/suất
            </td>
        </tr>
    </tfoot>
</table>
</div>
<div class="row text-center mt-4 print-only sign">
    <div class="col">Người lập biểu</div><div class="col">Quản lý bộ phận</div><div class="col">Phê duyệt</div>
</div>
